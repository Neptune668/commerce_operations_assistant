# ============================================================
# MySQL 数据库容器配置
# ============================================================
# MySQL root 用户密码（生产环境务必更换）
MYSQL_ROOT_PASSWORD=replace_with_random_urlsafe_32_char_secret
# 初始化时自动创建的数据库名
MYSQL_DATABASE=ecommerce_operation
# MySQL 对外暴露端口
MYSQL_PORT=3306

# ============================================================
# Redis 容器配置
# ============================================================
# Redis 对外暴露端口
REDIS_PORT=6379
# Redis 访问密码
REDIS_PASSWORD=replace_with_random_urlsafe_32_char_secret

# ============================================================
# Agent 检查点数据库容器配置（PostgreSQL）
# ============================================================
# PostgreSQL 用户名
AGENT_POSTGRES_USER=agent
# PostgreSQL 密码
AGENT_POSTGRES_PASSWORD=replace_with_random_32_char_secret
# 初始化时自动创建的数据库名
AGENT_POSTGRES_DATABASE=agent_checkpoints
# PostgreSQL 对外暴露端口
AGENT_POSTGRES_PORT=5433

# ============================================================
# 服务端口配置
# ============================================================
# API 服务对外暴露端口
API_PORT=8000
# 前端 Web 服务对外暴露端口
WEB_PORT=3000

# ============================================================
# 应用配置
# ============================================================
# 应用运行环境：development / staging / production
APP_ENV=development
# 认证签名密钥（生产环境务必更换）
AUTH_SECRET_KEY=dev-auth-secret-change-me
# Token 有效期（分钟），10080 分钟 = 7 天
AUTH_TOKEN_EXPIRE_MINUTES=10080
# Agent 单次运行允许消耗的最大 token 总量
AGENT_MAX_TOTAL_TOKENS=12000
# Agent 最大修订次数
AGENT_MAX_REVISIONS=1
# 可观测性服务名称
OTEL_SERVICE_NAME=ecommerce-operation-agent
# OTLP 采集器端点（留空表示不启用远程导出）
OTEL_EXPORTER_OTLP_ENDPOINT=
