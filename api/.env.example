# ============================================================
# 数据库配置（MySQL）
# ============================================================
# 数据库连接地址，使用 pymysql 驱动
# 格式：mysql+pymysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql+pymysql://root:replace_with_random_urlsafe_32_char_secret@127.0.0.1:3306/ecommerce_operation

# 应用运行环境：development / staging / production
APP_ENV=development

# 允许跨域访问的前端来源，多个来源用逗号分隔
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# ============================================================
# Redis 缓存配置
# ============================================================
# Redis 连接地址
# 格式：redis://:密码@主机:端口/数据库编号
REDIS_URL=redis://:replace_with_random_urlsafe_32_char_secret@127.0.0.1:6379/0

# ============================================================
# 任务队列配置（Celery）
# ============================================================
# 任务队列后端：inline 表示进程内同步执行（开发环境用），生产环境可改为 redis
TASK_QUEUE_BACKEND=inline
# Celery 默认任务队列名
CELERY_TASK_DEFAULT_QUEUE=generation
# Agent 任务队列名
CELERY_AGENT_QUEUE=agent
# Agent 工作流任务队列名
CELERY_AGENT_WORKFLOW_QUEUE=agent.workflow
# 维护任务队列名
CELERY_MAINTENANCE_QUEUE=maintenance

# ============================================================
# Agent 检查点存储配置（PostgreSQL）
# ============================================================
# 检查点数据库完整连接地址（留空则使用下方拆分字段拼接）
AGENT_CHECKPOINT_DATABASE_URL=
# 检查点数据库主机
AGENT_CHECKPOINT_HOST=127.0.0.1
# 检查点数据库端口
AGENT_CHECKPOINT_PORT=5433
# 检查点数据库用户名
AGENT_CHECKPOINT_USER=agent
# 检查点数据库密码
AGENT_CHECKPOINT_PASSWORD=replace_with_random_32_char_secret
# 检查点数据库名
AGENT_CHECKPOINT_DATABASE=agent_checkpoints

# ============================================================
# Agent 运行参数
# ============================================================
# Agent 单次运行允许消耗的最大 token 总量
AGENT_MAX_TOTAL_TOKENS=12000
# Agent 最大修订次数
AGENT_MAX_REVISIONS=1

# ============================================================
# 可观测性配置（OpenTelemetry）
# ============================================================
# 服务名称
OTEL_SERVICE_NAME=ecommerce-operation-agent
# OTLP 采集器端点（留空表示不启用远程导出）
OTEL_EXPORTER_OTLP_ENDPOINT=

# ============================================================
# 认证配置
# ============================================================
# 认证签名密钥（生产环境务必更换）
AUTH_SECRET_KEY=dev-auth-secret-change-me
# Token 有效期（分钟），10080 分钟 = 7 天
AUTH_TOKEN_EXPIRE_MINUTES=10080

# ============================================================
# 大语言模型配置（LLM）
# ============================================================
# LLM 服务基础地址
LLM_BASE_URL=https://api.deepseek.com
# LLM API Key
LLM_API_KEY=
# 使用的模型名称
LLM_MODEL=deepseek-v4-pro

# ============================================================
# 图片生成配置
# ============================================================
# 图片生成服务提供方
IMAGE_PROVIDER=dashscope
# 图片生成服务基础地址
IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# 图片生成 API Key
IMAGE_API_KEY=
# 图片生成模型
IMAGE_MODEL=wan2.6-t2i
# 生成图片尺寸（宽*高）
IMAGE_SIZE=1280*1280
# 图片生成工作空间 ID
IMAGE_WORKSPACE_ID=
# 轮询任务状态的间隔（秒）
IMAGE_POLL_INTERVAL_SECONDS=5
# 轮询任务状态的最大次数
IMAGE_POLL_MAX_ATTEMPTS=24

# ============================================================
# 视频生成配置
# ============================================================
# 视频生成服务提供方
VIDEO_PROVIDER=dashscope
# 视频生成服务基础地址
VIDEO_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# 视频生成 API Key
VIDEO_API_KEY=
# 视频生成模型
VIDEO_MODEL=wan2.6-t2v
# 生成视频尺寸（宽*高）
VIDEO_SIZE=1280*720
# 生成视频时长（秒）
VIDEO_DURATION=2
# 视频生成工作空间 ID
VIDEO_WORKSPACE_ID=
# 轮询任务状态的间隔（秒）
VIDEO_POLL_INTERVAL_SECONDS=10
# 轮询任务状态的最大次数
VIDEO_POLL_MAX_ATTEMPTS=36
